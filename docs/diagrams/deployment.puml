@startuml deployment
' UML deployment diagram: the topology of one run.
' Source of record for docs/diagrams/deployment.svg. Do not edit the SVG:
' render it with the pinned PlantUML image (docs/adopting.md).
' &#45;&#45; is a literal "--": PlantUML reads --text-- as strikeout.
title agentjail: host, per-run network, jail, and a dual-homed class gateway

node "host\nrootless podman" as host {
  node "jail container\nagentjail-<profile>-<pid>\nrootfs read-only, uid 10000 (keep-id)\nbounded tmpfs: /tmp 64m, /run 16m, home 0700" as jail {
    artifact "agentjail-launcher\nstatic musl, PID 1" as launcher
    component "agent process\nany agent" as agent
  }

  node "per-run internal network\nagentjail-<profile>-<pid>-<class>\ninternal=true, IPv4 only, no upstream route" as internal

  node "gateway container\nagentjail-<profile>-<pid>-gateway\ndual-homed: DNS :53, CONNECT :3128\nimage pinned by ID, read-only rootfs\nall caps dropped but NET_BIND_SERVICE" as gateway

  node "per-run egress network\nagentjail-<profile>-<pid>-egress" as egress

  database "state dir\n~/.local/state/agentjail/audit/<class>" as state
}

artifact "one binary, three classes\ngateway/classes/<class>.toml\nmodel | external | internal" as classcfg
cloud "destination on the class allowlist\nhost:port, exact name or *.suffix" as destination

launcher --> agent : exec
jail -down-> internal : the gateway is its only peer
gateway -up-> internal : internal leg
gateway -down-> egress : egress leg
gateway -down-> state : audit and dns streams
gateway -right-> destination : CONNECT after resolve once
classcfg -down-> gateway : the class this run names
jail ..> egress : never a member

legend bottom
  The class is decided by network membership, not by a rule inside a shared
  proxy: the jail joins the per-run network named after its class and the only
  other peer on it is that class's gateway. model, external and internal are
  three instances of the same binary with three different configs.
  Jail: no host file, no runtime socket, no unlisted environment.
endlegend
@enduml
