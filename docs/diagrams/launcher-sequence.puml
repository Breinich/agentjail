@startuml launcher-sequence
' UML sequence diagram: pipes, signals, exit code.
' Source of record for launcher-sequence.svg - render with the pinned PlantUML image.
title run transport: pipes, signals, exit code

participant "host harness" as H
participant "agentjail run" as C
participant "podman" as P
participant "container PID 1\ntini" as T
participant "agent" as A

H -> C : start, fd 0/1/2 attached
C -> P : run --rm --interactive\n(pipes, never a TTY)
P -> T : start PID 1
T -> A : exec the entrypoint
H ->> C : stdin frames
C ->> P : bytes in
P ->> T : bytes in
T ->> A : fd 0
A ->> T : stdout and stderr
T ->> P : same streams
P ->> C : same streams
C ->> H : stdout and stderr
note over H, A : all three streams are separate pipes;\nstdin close ends the session
H ->> C : SIGTERM
C ->> P : forward unchanged
P ->> T : to PID 1
T ->> A : to its only child
A --> T : exit code
T --> P : exit code
P --> C : exit code
C --> H : exit code, or 128+N
@enduml
